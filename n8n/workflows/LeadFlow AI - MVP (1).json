    {
      "parameters": {
        "jsCode": "const validLeads = [];\nconst invalidLeads = [];\n\nfor (const item of $input.all()) {\n  const lead = item.json;\n\n  const errors = [];\n\n  // Required fields\n  if (!lead.name?.trim()) {\n    errors.push(\"Missing name\");\n  }\n\n  if (!lead.email?.trim()) {\n    errors.push(\"Missing email\");\n  }\n\n  if (!lead.company?.trim()) {\n    errors.push(\"Missing company\");\n  }\n\n  // Basic email validation\n  if (\n    lead.email &&\n    !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(lead.email)\n  ) {\n    errors.push(\"Invalid email\");\n  }\n\n  // Basic website validation\n  if (\n    lead.website &&\n    !/^https?:\\/\\/.+/.test(lead.website)\n  ) {\n    errors.push(\"Invalid website\");\n  }\n\n  // Employee count validation\n  if (\n    lead.employees !== undefined &&\n    lead.employees !== \"\" &&\n    isNaN(Number(lead.employees))\n  ) {\n    errors.push(\"Invalid employee count\");\n  }\n\n  if (errors.length === 0) {\n    validLeads.push({\n      json: {\n        ...lead,\n        validation_status: \"valid\",\n        validation_errors: []\n      }\n    });\n  } else {\n    invalidLeads.push({\n      json: {\n        ...lead,\n        validation_status: \"invalid\",\n        validation_errors: errors\n      }\n    });\n  }\n}\n\nreturn validLeads;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "65fabe7d-c4d2-4010-9cea-9fa0993f1429",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst uniqueLeads = [];\n\nfor (const item of $input.all()) {\n  const lead = item.json;\n\n  const key = (\n    lead.email ||\n    `${lead.company}-${lead.name}`\n  ).toLowerCase().trim();\n\n  if (!seen.has(key)) {\n    seen.add(key);\n\n    uniqueLeads.push({\n      json: {\n        ...lead,\n        duplicate_status: \"unique\"\n      }\n    });\n  }\n}\n\nreturn uniqueLeads;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
