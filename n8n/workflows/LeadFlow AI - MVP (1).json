    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3.2:3b\",\n  \"stream\": false,\n  \"format\": \"json\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Write only a short generic B2B outreach message about AI workflow automation. Do not mention any names, companies, industries, employee counts, pain points, buying signals, or facts. Do not use placeholders. Return JSON with exactly one field: outreach_body.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a natural 40-60 word outreach body for an AI automation freelancer. Keep it general and professional. Do not include a greeting or signature.\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2336,
        -448
      ],
      "id": "6c269722-baee-4c42-89e0-75a6912451ae",
      "name": "Generate Outreach"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const lead = $('Code in JavaScript2').item.json;\n\n  const content = item.json.message.content;\n  const parsed = JSON.parse(content);\n\n  const outreachBody = parsed.outreach_body;\n\n  results.push({\n    json: {\n      ...lead,\n      outreach_message: `Hi ${lead.name},\n\nI came across ${lead.company} and noticed you're in the ${lead.industry} space.\n\n${outreachBody}\n\nBest regards,\nNihaal`\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2544,
        -448
      ],
      "id": "3590fefa-9fec-4eb4-8188-6290c9b39c6f",
      "name": "Build Outreach Message"
    }
